{
  "compilerOptions": {
    "target": "ES6",
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node", "express", "jsonwebtoken", "bcrypt"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}